{
  "name": "sidebro-ai",
  "version": "1.0.0",
  "description": "SideBro AI \u2014 Real-Time Second-Screen Interview Wingman & Technical Conversation Copilot",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "start:server": "npm run start --workspace=server",
    "test": "npm run test --workspace=server",
    "e2e": "npm run e2e --workspace=server",
    "docker:build": "docker compose build",
    "docker:up": "HOST_IP=${HOST_IP:-$(ipconfig getifaddr en0 2>/dev/null)} docker compose up -d --build",
    "docker:down": "docker compose down",
    "electron": "env -u ELECTRON_RUN_AS_NODE electron ./electron/main.cjs",
    "dev:electron": "concurrently -n \"SERVERS,ELECTRON\" -c \"cyan,green\" \"npm run dev\" \"env -u ELECTRON_RUN_AS_NODE electron ./electron/main.cjs\"",
    "docker:logs": "docker compose logs -f sidebro",
    "electron:docker": "env -u ELECTRON_RUN_AS_NODE PORT=${SIDEBRO_PORT:-3001} electron ./electron/main.cjs"
  },
  "keywords": [
    "realtime",
    "ai",
    "copilot",
    "interview-assistant",
    "second-screen",
    "transcription",
    "websocket"
  ],
  "author": "Mohan Sharma",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "typescript": "^5.7.3"
  }
}
