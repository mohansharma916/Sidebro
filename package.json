{
  "name": "sidebro-ai",
  "version": "1.0.0",
  "description": "SideBro AI — Real-Time Second-Screen Interview Wingman & Technical Conversation Copilot",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "start:server": "npm run start --workspace=server",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "electron": "electron ./electron/main.cjs"
  },
  "keywords": [
    "realtime",
    "ai",
    "copilot",
    "interview-assistant",
    "second-screen",
    "transcription",
    "websocket"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "typescript": "^5.7.3"
  }
}
