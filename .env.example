# SideBro AI Environment Configuration

# Server Port (Default: 3001)
PORT=3001

# --- Answer generation (LLM) ---------------------------------------------
# Choose your preferred provider (groq | openai | gemini). If unset, auto-detected.
# AI_PROVIDER=groq

# 1. Groq (Ultra-fast cloud inference, ~200ms TTFT)
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# Available Groq models: qwen/qwen3.8-27b, openai/gpt-oss-20b, openai/gpt-oss-120b
# GROQ_MODEL=qwen/qwen3.8-27b

# 2. OpenAI / ChatGPT (or OpenAI-compatible APIs)
# OPENAI_API_KEY=sk-your_openai_key_here
# OPENAI_MODEL=gpt-4o-mini
# For custom OpenAI-compatible endpoints (Ollama, DeepSeek, OpenRouter, Together AI):
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
# For local offline Ollama on Mac:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.2

# 3. Google Gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# Without any LLM key, the server serves offline senior interview response blueprints.

# --- Coding problems from clipboard & screenshots (desktop app) --------------
# Copied text is solved with the providers above. Screenshots need a vision model:
# OpenAI (gpt-4o-mini) or Gemini work out of the box; Groq only with GROQ_VISION_MODEL set.
# VISION_PROVIDER=openai
# OPENAI_VISION_MODEL=gpt-4o-mini
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Solution language when the problem/editor does not show one (profile language wins if set)
# CODING_LANGUAGE=Go
# Global screenshot hotkey (Electron accelerator syntax)
# SIDEBRO_SCREENSHOT_HOTKEY=CommandOrControl+Alt+Shift+S
# Set to 0 to stop sending copied text to the AI
# SIDEBRO_CLIPBOARD_WATCH=0

# --- Speech-to-text (Whisper) ----------------------------------------------
# Groq Whisper uses GROQ_API_KEY above. OpenAI Whisper is the fallback:
# OPENAI_API_KEY=your_openai_api_key_here

# --- Storage ---------------------------------------------------------------
# SQLite directory (default: server/data)
# DATA_DIR=/absolute/path/to/data

# --- Security --------------------------------------------------------------
# Enables cross-session admin endpoints (GET /api/sessions, /api/analytics/*).
# Leave unset to keep them disabled.
# ADMIN_TOKEN=generate-a-long-random-string
# Extra browser origins allowed to call the API (localhost and private LAN IPs are always allowed)
# CORS_ORIGINS=https://my-host.example

# --- Docker ------------------------------------------------------------------
# Host port for `npm run docker:up` (container always listens on 3001 internally)
# SIDEBRO_PORT=3001
# LAN IP shown in the phone pairing QR code (npm run docker:up auto-detects it on macOS)
# HOST_IP=192.168.1.10
